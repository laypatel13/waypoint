---
// Refreshes the merged PR numbers rendered at build time with live counts from
// GitHub. Elements opt in with data-pr-query="<search query>" (one repo) or
// data-pr-total (the sum of every query on the page). If GitHub can't be
// reached or rate-limits the visitor, the build-time numbers simply stay.
---

<script>
  const KEY = "pr-counts";
  const TTL = 10 * 60 * 1000;

  const repoEls = Array.from(document.querySelectorAll<HTMLElement>("[data-pr-query]"));
  const totalEls = Array.from(document.querySelectorAll<HTMLElement>("[data-pr-total]"));
  const queries = [...new Set(repoEls.map((el) => el.dataset.prQuery ?? ""))].filter(Boolean);

  type Cached = { at: number; counts: Record<string, number> };

  const readCache = (): Cached | null => {
    try {
      const cached: Cached | null = JSON.parse(sessionStorage.getItem(KEY) ?? "null");
      return cached && Date.now() - cached.at < TTL ? cached : null;
    } catch {
      return null;
    }
  };

  const writeCache = (counts: Record<string, number>) => {
    try {
      sessionStorage.setItem(KEY, JSON.stringify({ at: Date.now(), counts }));
    } catch {}
  };

  const fetchCount = async (query: string) => {
    const url = `https://api.github.com/search/issues?per_page=1&q=${encodeURIComponent(query)}`;
    const res = await fetch(url, { headers: { Accept: "application/vnd.github+json" } });
    if (!res.ok) throw new Error(`GitHub search ${res.status}`);
    const { total_count } = (await res.json()) as { total_count: number };
    return total_count;
  };

  const apply = (counts: Record<string, number>) => {
    repoEls.forEach((el) => {
      const n = counts[el.dataset.prQuery ?? ""];
      if (typeof n === "number") el.textContent = String(n);
    });
    const total = queries.reduce((sum, q) => sum + (counts[q] ?? NaN), 0);
    if (Number.isFinite(total)) totalEls.forEach((el) => (el.textContent = String(total)));
  };

  const refresh = async () => {
    if (!queries.length) return;
    const cached = readCache();
    if (cached) return apply(cached.counts);
    try {
      const results = await Promise.all(queries.map(fetchCount));
      const counts = Object.fromEntries(queries.map((q, i) => [q, results[i]]));
      writeCache(counts);
      apply(counts);
    } catch {
      // keep the build-time numbers
    }
  };

  refresh();
</script>
