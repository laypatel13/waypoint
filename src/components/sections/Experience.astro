---
type OrgLink = {
  label: string;
  href: string | null;
};

type Role = {
  title: string;
  org: OrgLink[];
  period: string;
  description: string;
};

const roles: Role[] = [
  {
    title: "Open Source Contributor",
    org: [{ label: "freeCodeCamp", href: "https://github.com/freeCodeCamp/freeCodeCamp" }],
    period: "jul '26 — present",
    description:
      "Working through freeCodeCamp's open source, contributing to Naomi's sprints initiative - replacing regex based test cases with the Explorer AST helper across the JS curriculum.",
  },
  {
    title: "Python & AI Development Trainee",
    org: [
      { label: "TutorialsPoint", href: "https://training.tutorialspoint.com/" },
      { label: "National Skill India", href: "https://www.skillindiadigital.gov.in/home" },
    ],
    period: "may '26 — aug '26",
    description: "Structured training in Python and AI development fundamentals via Skill India Digital under TutorialsPoint.",
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="section-head" data-reveal>
    <span class="idx" aria-hidden="true">02</span>
    <h2 id="experience-title">experience</h2>
  </div>

  <ol class="timeline">
    {
      roles.map((role, i) => (
        <li class:list={["role", { current: role.period.includes("present") }]} data-reveal style={`--i:${i}`}>
          <p class="period">{role.period}</p>
          <h3 class="role-title">{role.title}</h3>
          <p class="org">
            {role.org.map((part, j) => (
              <>
                {j > 0 && <span class="sep" aria-hidden="true"> · </span>}
                {part.href ? (
                  <a href={part.href} target="_blank" rel="noopener noreferrer">
                    {part.label}
                  </a>
                ) : (
                  part.label
                )}
              </>
            ))}
          </p>
          <p class="role-desc">{role.description}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience {
    margin: var(--section-gap) 0;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* the rail */
  .timeline::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 1px;
    background: var(--border-strong);
  }

  .role {
    position: relative;
    padding: 0 0 var(--space-6) var(--space-6);
  }

  .role:last-child {
    padding-bottom: 0;
  }

  /* the node */
  .role::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 11px;
    height: 11px;
    border: 2px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg);
  }

  .role.current::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .period {
    margin: 0 0 var(--space-1);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .role.current .period {
    color: var(--accent);
  }

  .role-title {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .org {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .org a {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color var(--dur-fast) ease, text-decoration-color var(--dur-fast) ease;
  }

  .org a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* inline links: grow the touch area without changing the line spacing */
  @media (pointer: coarse) {
    .org a {
      padding-block: 13px;
    }
  }

  .role-desc {
    max-width: var(--measure);
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
