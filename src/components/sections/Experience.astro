---
type OrgLink = {
  label: string;
  href: string | null;
};

type Role = {
  title: string;
  org: OrgLink[];
  period: string;
  description: string;
};

const roles: Role[] = [
  {
    title: "Open Source Contributor",
    org: [{ label: "freeCodeCamp", href: "https://github.com/freeCodeCamp/freeCodeCamp" }],
    period: "jul '26 — present",
    description:
      "Working through freeCodeCamp's open source, contributing to Naomi's sprints initiative - replacing regex based test cases with the Explorer AST helper across the JS curriculum.",
  },
  {
    title: "Python & AI Development Trainee",
    org: [
      { label: "TutorialsPoint", href: "https://training.tutorialspoint.com/" },
      { label: "National Skill India", href: "https://www.skillindiadigital.gov.in/home" },
    ],
    period: "may '26 — aug '26",
    description: "Structured training in Python and AI development fundamentals via Skill India Digital under TutorialsPoint.",
  },
];
---

<section id="experience" class="experience">
  <p class="section-label">experience</p>
  <ul>
    {
      roles.map((role) => (
        <li>
          <div class="role">
            <span class="period">{role.period}</span>
            <div class="role-info">
              <h3 class="role-title">
                {role.title}
                <span class="org">
                  {" @ "}
                  {role.org.map((part, i) => (
                    <>
                      {i > 0 && " × "}
                      {part.href ? (
                        <a href={part.href} target="_blank" rel="noopener noreferrer">
                          {part.label}
                        </a>
                      ) : (
                        part.label
                      )}
                    </>
                  ))}
                </span>
              </h3>
              <p class="role-desc">{role.description}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .experience {
    margin: 48px 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border-top: 0.5px solid var(--border);
  }

  li:last-child {
    border-bottom: 0.5px solid var(--border);
  }

  .role {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    width: 132px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .role-info {
    flex: 1;
    min-width: 0;
  }

  .role-title {
    font-size: 15px;
    margin: 0 0 6px;
    font-weight: 500;
  }

  .org {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .org a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .org a:hover,
  .org a:focus-visible {
    color: var(--text);
  }

  .role-desc {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 480px) {
    .role {
      flex-direction: column;
      gap: 4px;
    }

    .period {
      width: auto;
    }
  }
</style>
