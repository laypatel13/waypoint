---
const toolRepos = [
  "https://github.com/laypatel13/data-visualizer",
  "https://github.com/laypatel13/sales-report",
  "https://github.com/laypatel13/grade-analyzer",
  "https://github.com/laypatel13/csv-analyzer",
  "https://github.com/laypatel13/animal-shelter",
  "https://github.com/laypatel13/library-manager",
  "https://github.com/laypatel13/expense-tracker",
];
---

<div id="cli-tools" class="cli-tools" data-reveal>
  <div class="card">
    <div class="copy">
      <h3 id="cli-title">{toolRepos.length} small CLI tools</h3>
      <p>Published on PyPI, from back when I was first learning Python.</p>
    </div>

    <!-- works as a plain link to the profile without JS; the script below swaps in a random repo -->
    <a
      id="random-tool"
      class="btn btn-ghost btn-sm"
      href="https://github.com/laypatel13"
      target="_blank"
      rel="noopener noreferrer"
      data-repos={JSON.stringify(toolRepos)}
      aria-label="Surprise me: open a random CLI tool on GitHub (opens in a new tab)"
    >
      surprise me
      <svg class="ico-out" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    </a>
  </div>
</div>

<script>
  const link = document.getElementById("random-tool");
  link?.addEventListener("click", (event) => {
    const repos: string[] = JSON.parse(link.dataset.repos ?? "[]");
    if (!repos.length) return;
    event.preventDefault();
    const pick = repos[Math.floor(Math.random() * repos.length)];
    window.open(pick, "_blank", "noopener,noreferrer");
  });
</script>

<style>
  .cli-tools {
    margin-top: var(--space-6);
  }

  .card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  h3 {
    font-size: 1.375rem;
    margin: 0 0 var(--space-1);
  }

  p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .btn {
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    p {
      font-size: var(--text-base);
    }
  }
</style>
