---
type Project = {
  name: string;
  description: string;
  tags: string[];
  demo: string | null;
  github: string | null;
};

const projects: Project[] = [
  {
    name: "clutch",
    description: "Open source developer activity dashboard with a FastAPI backend, a React frontend and a CLI published on PyPI.",
    tags: ["Python 3.11", "FastAPI 0.103", "React 18", "TypeScript 5.0", "Tailwind 3.4"],
    demo: "https://clutch-woad.vercel.app",
    github: "https://github.com/laypatel13/clutch",
  },
  {
    name: "datawash",
    description: "Cleans and analyzes CSV files - upload messy data, get instant insights.",
    tags: ["Python 3.11", "Flask 3.0.3", "Numpy 1.26", "Pandas 2.2", "Plotly 5.22"],
    demo: "https://data-wash-sr98.onrender.com",
    github: "https://github.com/laypatel13/data-wash",
  },
];

// chips show the technology; the exact version stays available on hover
const stripVersion = (tag: string) => tag.replace(/\s+v?[\d.]+$/, "");
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="section-head" data-reveal>
    <span class="idx" aria-hidden="true">01</span>
    <h2 id="work-title">work</h2>
  </div>

  <div class="list">
    {
      projects.map((project, i) => (
        <div class="cell" data-reveal style={`--i:${i}`}>
          <article class="project">
            <div class="body">
              <h3 class="project-title">{project.name}</h3>
              <p class="project-desc">{project.description}</p>

              {project.tags.length > 0 && (
                <ul class="tags" aria-label="Technologies">
                  {project.tags.map((tag) => (
                    <li class="tag" title={tag}>
                      {stripVersion(tag)}
                    </li>
                  ))}
                </ul>
              )}

              <div class="actions">
                {project.demo && (
                  <a
                    class="btn btn-primary btn-sm"
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.name} live demo (opens in a new tab)`}
                  >
                    live demo
                    <svg class="ico-out" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </a>
                )}
                {project.github && (
                  <a
                    class="btn btn-ghost btn-sm"
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.name} source code (opens in a new tab)`}
                  >
                    source
                    <svg class="ico-out" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>

<style>
  .work {
    margin: var(--section-gap) 0 var(--space-6);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: var(--space-5);
  }

  .cell {
    display: flex;
  }

  .project {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: var(--shadow-1);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) ease;
  }

  @media (hover: hover) {
    .project:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-3);
      border-color: var(--border-strong);
    }
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-5);
  }

  .project-title {
    margin: 0 0 var(--space-2);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .project-desc {
    margin: 0 0 var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }
</style>
