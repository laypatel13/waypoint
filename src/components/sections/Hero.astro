---
import { getMergedCounts } from "../../lib/github";

const { total } = await getMergedCounts();

// `live` marks the number PrCounts refreshes in the browser
const proof = [
  { value: String(total), label: "merged open source PRs", href: "#open-source", live: true },
  { value: "top 21", label: "of 600+ at GIFT hackathon", href: "#highlights", live: false },
];
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-text">
    <p class="kicker" data-reveal style="--i:0">hi, i’m</p>
    <h1 id="hero-title" data-reveal style="--i:1">Lay Patel<span class="stop">.</span></h1>
    <p class="tagline" data-reveal style="--i:2">
      Second-year CSE(AI/ML) student <a
        href="https://www.adaniuni.ac.in/"
        target="_blank"
        rel="noopener noreferrer">@adani university</a
      > building and contributing to open source.
    </p>
    <ul class="proof" data-reveal style="--i:3">
      {
        proof.map((item) => (
          <li>
            <a href={item.href}>
              <span class="proof-value" data-pr-total={item.live || undefined}>{item.value}</span>
              <span class="proof-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="actions" data-reveal style="--i:4">
      <a class="btn btn-primary" href="#open-source">
        see my open source
        <svg class="ico-down" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </a>
      <a class="btn btn-ghost" href="#contact">get in touch</a>
    </div>
  </div>

  <svg class="hero-art" viewBox="0 0 160 160" width="176" height="176" aria-hidden="true">
    <ellipse class="ripple" cx="80" cy="132" rx="16" ry="4.5" />
    <ellipse class="ripple" cx="80" cy="132" rx="34" ry="9" />
    <ellipse class="ripple" cx="80" cy="132" rx="54" ry="14" />
    <g transform="translate(10 6)">
      <path
        class="pin"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M70 20 C50 20 34 36 34 56 C34 84 70 122 70 122 C70 122 106 84 106 56 C106 36 90 20 70 20 Z
           M70 40 C81 40 90 47.5 90 57 C90 66.5 81 74 70 74 C59 74 50 66.5 50 57 C50 47.5 59 40 70 40 Z"
      />
    </g>
  </svg>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin: var(--space-4) 0 var(--section-gap);
    padding: clamp(32px, 6vw, 72px) clamp(24px, 5vw, 64px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(520px circle at 100% 0%, var(--accent-soft), transparent 65%),
      var(--surface);
    overflow: hidden;
  }

  .hero-text {
    max-width: 520px;
  }

  /* reads as the start of one sentence with the name: "hi, i'm Lay Patel." */
  .kicker {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.625rem);
    line-height: 1.2;
    color: var(--text-secondary);
  }

  h1 {
    font-size: clamp(2.25rem, 1.2rem + 5.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }

  .stop {
    color: var(--accent);
  }

  .tagline {
    max-width: 44ch;
    margin: 0 0 var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tagline a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .tagline a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .proof a {
    display: flex;
    flex-direction: column;
    min-height: 44px;
    justify-content: center;
    text-decoration: none;
  }

  .proof-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--text);
    transition: color var(--dur-fast) ease;
  }

  .proof-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .proof a:hover .proof-value {
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-art {
    flex-shrink: 0;
    color: var(--accent);
  }

  .ripple {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .pin {
    fill: var(--accent);
  }

  .js .pin {
    animation: pin-drop 900ms var(--ease-out) 350ms both;
    transform-origin: 70px 122px;
  }

  .js .ripple {
    animation: ripple-in 900ms var(--ease-out) 650ms both;
    transform-origin: 80px 132px;
  }

  @keyframes pin-drop {
    from {
      opacity: 0;
      transform: translateY(-28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ripple-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 640px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .hero-art {
      width: 96px;
      height: 96px;
      margin-bottom: calc(var(--space-2) * -1);
    }
  }

  /* narrow phones: tighter card padding for wider text, stats side by side,
     buttons share each row or stretch to full width when they wrap */
  @media (max-width: 480px) {
    .hero {
      padding-inline: 20px;
    }

    .proof {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    .proof-label {
      font-size: var(--text-sm);
      line-height: 1.4;
    }

    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
