---
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero-text">
    <p class="kicker" data-reveal style="--i:0">hi, i’m</p>
    <h1 id="hero-title" data-reveal style="--i:1">Lay Patel<span class="stop">.</span></h1>
    <p class="tagline" data-reveal style="--i:2">
      Second-year CSE(AI/ML) student <a
        href="https://www.adaniuni.ac.in/"
        target="_blank"
        rel="noopener noreferrer">@adani university</a
      > building and contributing to open source.
    </p>
    <div class="actions" data-reveal style="--i:3">
      <a class="btn btn-primary" href="#work">
        view my work
        <svg class="ico-down" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </a>
      <a class="btn btn-ghost" href="#contact">get in touch</a>
    </div>
  </div>

  <svg class="hero-art" viewBox="0 0 160 160" width="176" height="176" aria-hidden="true">
    <ellipse class="ripple" cx="80" cy="132" rx="16" ry="4.5" />
    <ellipse class="ripple" cx="80" cy="132" rx="34" ry="9" />
    <ellipse class="ripple" cx="80" cy="132" rx="54" ry="14" />
    <g transform="translate(10 6)">
      <path
        class="pin"
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M70 20 C50 20 34 36 34 56 C34 84 70 122 70 122 C70 122 106 84 106 56 C106 36 90 20 70 20 Z
           M70 40 C81 40 90 47.5 90 57 C90 66.5 81 74 70 74 C59 74 50 66.5 50 57 C50 47.5 59 40 70 40 Z"
      />
    </g>
  </svg>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin: var(--space-4) 0 var(--section-gap);
    padding: clamp(32px, 6vw, 72px) clamp(24px, 5vw, 64px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(520px circle at 100% 0%, var(--accent-soft), transparent 65%),
      var(--surface);
    overflow: hidden;
  }

  .hero-text {
    max-width: 520px;
  }

  /* reads as the start of one sentence with the name: "hi, i'm Lay Patel." */
  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.625rem);
    line-height: 1.2;
    color: var(--text-secondary);
  }

  /* accent rule that draws in from the left once the kicker reveals */
  .kicker::before {
    content: "";
    flex-shrink: 0;
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .js .kicker::before {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 700ms var(--ease-out) 250ms;
  }

  .js .kicker.is-visible::before,
  .js.reveal-fallback .kicker::before {
    transform: none;
  }

  h1 {
    font-size: clamp(2.75rem, 1.8rem + 4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }

  .stop {
    color: var(--accent);
  }

  .tagline {
    max-width: 44ch;
    margin: 0 0 var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tagline a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .tagline a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-art {
    flex-shrink: 0;
    color: var(--accent);
  }

  .ripple {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .pin {
    fill: var(--accent);
  }

  .js .pin {
    animation: pin-drop 900ms var(--ease-out) 350ms both;
    transform-origin: 70px 122px;
  }

  .js .ripple {
    animation: ripple-in 900ms var(--ease-out) 650ms both;
    transform-origin: 80px 132px;
  }

  @keyframes pin-drop {
    from {
      opacity: 0;
      transform: translateY(-28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ripple-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 640px) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .hero-art {
      width: 120px;
      height: 120px;
    }
  }
</style>
