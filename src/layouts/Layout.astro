---
import "../styles/global.css";
import { getMergedCounts } from "../lib/github";

interface Props {
  title?: string;
  description?: string;
}

const { total } = await getMergedCounts();

const {
  title = "waypoint - laypatel13",
  description = `Second-year CSE(AI/ML) student at Adani University. ${total} merged PRs across freeCodeCamp and Learning Unlimited.`,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Sora:wght@400;500&family=Poppins:wght@400;500&display=swap"
    />

    <!-- Runs before first paint: applies the saved/system theme (no flash) and
         enables the reveal styles. If the reveal script never starts, content
         is force-shown after 3s so nothing stays invisible. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#0f0f0c" : "#fbfaf7");
        root.classList.add("js");
        setTimeout(function () {
          if (!root.dataset.revealReady) root.classList.add("reveal-fallback");
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <div id="custom-cursor" aria-hidden="true"><span></span></div>
    <slot />
    <button type="button" id="back-to-top" aria-label="Back to top" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m6 15 6-6 6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </body>
</html>

<style>
  body {
    position: relative;
  }

  #back-to-top {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface-raised);
    color: var(--text);
    box-shadow: var(--shadow-2);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility 0s linear var(--dur),
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  #back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  @media (hover: hover) {
    #back-to-top.visible:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---- scroll reveal ------------------------------------------------
  const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
    );
    revealEls.forEach((el) => io.observe(el));
  }
  root.dataset.revealReady = "1";

  // ---- custom cursor ring (fine pointers, no reduced motion) --------
  const cursor = document.getElementById("custom-cursor");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (cursor && finePointer && !reduceMotion) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let started = false;
    let frame = 0;

    const render = () => {
      x += (targetX - x) * 0.22;
      y += (targetY - y) * 0.22;
      cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      frame =
        Math.abs(targetX - x) > 0.1 || Math.abs(targetY - y) > 0.1
          ? requestAnimationFrame(render)
          : 0;
    };

    window.addEventListener(
      "mousemove",
      (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
        if (!started) {
          started = true;
          x = targetX;
          y = targetY;
          cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          // only hide the native cursor once the ring is actually tracking
          root.classList.add("cursor-ring");
        }
        cursor.classList.add("active");
        if (!frame) frame = requestAnimationFrame(render);
      },
      { passive: true },
    );

    document.addEventListener("mouseout", (e) => {
      if (!e.relatedTarget) cursor.classList.remove("active");
    });

    document.addEventListener("mouseover", (e) => {
      const target = e.target as Element | null;
      cursor.classList.toggle(
        "hovering",
        !!target?.closest("a, button, summary, label, [role='button']"),
      );
    });

    window.addEventListener("mousedown", () => cursor.classList.add("pressed"));
    window.addEventListener("mouseup", () => cursor.classList.remove("pressed"));
  }

  // ---- back to top --------------------------------------------------
  const backToTop = document.getElementById("back-to-top");
  if (backToTop) {
    backToTop.hidden = false;
    let shown = false;
    const update = () => {
      const next = window.scrollY > 400;
      if (next !== shown) {
        shown = next;
        backToTop.classList.toggle("visible", shown);
      }
    };
    window.addEventListener("scroll", update, { passive: true });
    update();

    backToTop.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });
  }
</script>
